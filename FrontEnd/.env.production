# FileSphere - Production Environment Configuration
# These variables are loaded when building the app for production (npm run build)

# Backend service base URLs
# Leave empty to use relative paths (e.g., same-origin routing behind a reverse proxy like Nginx)
# Or change to absolute URLs (e.g., https://api.filesphere.com) as needed

API_BASE_URL=https://filesphere-backend-1-0.onrender.com

# App Settings
ENV=production
EBUG=false
